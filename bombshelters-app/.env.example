# ==============================================================================
# BombShelters.com - Environment Configuration Example
# Copy this file to `.env.local` for local development or set in your production host.
# Do NOT commit `.env.local` or any file containing private credentials.
# ==============================================================================

# ModularHome Backend Integration (Optional forwarder)
# Server-side preferred: MODULARHOME_API_URL, fallback: NEXT_PUBLIC_MODULARHOME_API_URL
MODULARHOME_API_URL="http://localhost:3000"
NEXT_PUBLIC_MODULARHOME_API_URL="http://localhost:3000"

# Supabase Configuration (Server & Client)
NEXT_PUBLIC_SUPABASE_URL="https://sxrteizeakvrrkmllwgo.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Direct PostgreSQL Database Connection
# If your database password contains special characters, percent-encode them in the connection string.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.sxrteizeakvrrkmllwgo.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.sxrteizeakvrrkmllwgo.supabase.co:5432/postgres"

# PostgreSQL Individual Connection Parameters
PGHOST="db.sxrteizeakvrrkmllwgo.supabase.co"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="[YOUR-PASSWORD]"

# Privileged Server-Side Service Role Key (NEVER expose to client / NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# BombShelter Admin Session Authentication
# Cryptographic secret for signing JWT admin session cookies (isolated cookie: bombshelters_admin_session)
BOMBSHELTER_ADMIN_SESSION_SECRET="your-strong-random-session-secret"

# Default BombShelter Admin Credentials (Used for fallback emergency access)
BOMBSHELTER_ADMIN_EMAIL="admin@bombshelters.com"
BOMBSHELTER_ADMIN_PASSWORD="YourSecurePasswordHere!"
